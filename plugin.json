{
  "id": "opss.focus-capture",
  "name": "FocusCapture",
  "version": "1.0.0",
  "description": "Hotkey-toggled capture of the focused application's audio output, mixed into the MicYou mic stream so call peers hear it. Press the hotkey again anywhere to stop.",
  "descriptionI18n": {
    "zh": "快捷键一键捕获当前焦点应用的声音，混入 MicYou 麦克风流让对方听到；在任意应用中再按同一快捷键即停止。",
    "zh-CN": "快捷键一键捕获当前焦点应用的声音，混入 MicYou 麦克风流让对方听到；在任意应用中再按同一快捷键即停止。"
  },
  "nameI18n": {
    "zh": "焦点声音捕获",
    "zh-CN": "焦点声音捕获"
  },
  "license": "Unlicense",
  "runtime": "native",
  "entry": "focus_capture",
  "platforms": [
    "windows",
    "linux",
    "macos"
  ],
  "arches": [
    "x86_64",
    "aarch64"
  ],
  "apiVersion": 1,
  "capabilities": [
    "dsp.node",
    "config.read",
    "config.write"
  ],
  "kind": "dsp",
  "dsp": {
    "insertAfter": "VAD",
    "realtimeSafe": true
  },
  "ui": {
    "route": "panel",
    "label": "FocusCapture",
    "panels": [
      {
        "id": "status",
        "label": "FocusCapture",
        "entry": "panel.html"
      }
    ]
  },
  "keywords": [
    "loopback",
    "process-audio",
    "wasapi",
    "mix",
    "hotkey",
    "windows"
  ],
  "config": {
    "hotkey": "ctrl+shift+f8",
    "gain": 1.0,
    "notify": true,
    "fc_status": {
      "phase": "idle",
      "app": "",
      "pid": 0,
      "rate": 0,
      "channels": 0,
      "error": "",
      "hotkey": "ctrl+shift+f8",
      "hotkeyOk": false
    }
  },
  "configSchema": {
    "fields": [
      {
        "key": "hotkey",
        "fieldType": "string",
        "label": "全局快捷键 Hotkey",
        "description": "格式：修饰键 ctrl/alt/shift/win + 主键（a-z、0-9、f1-f24、space、enter 等），例如 ctrl+shift+f8。修改后立即生效（旧组合自动失效）。鼠标侧键暂不支持（计划由宿主 API 提供）。",
        "default": "ctrl+shift+f8"
      },
      {
        "key": "gain",
        "fieldType": "number",
        "label": "混音增益 Gain",
        "description": "捕获声音混入麦克风时的线性增益（1.0 = 原始音量）。",
        "min": 0,
        "max": 2,
        "step": 0.05,
        "default": 1.0
      },
      {
        "key": "notify",
        "fieldType": "boolean",
        "label": "系统通知 Notifications",
        "description": "开始 / 停止 / 出错时弹出系统通知。",
        "default": true
      }
    ]
  },
  "repository": "https://github.com/OrientCOMPASS/Focus-Capture",
  "homepage": "https://github.com/OrientCOMPASS/Focus-Capture",
  "updateUrl": "https://github.com/OrientCOMPASS/Focus-Capture/releases/latest/download/plugin.json",
  "readmeUrl": "https://raw.githubusercontent.com/OrientCOMPASS/Focus-Capture/refs/heads/main/README.md"
}